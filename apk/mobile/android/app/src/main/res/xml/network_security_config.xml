<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted at the platform level because the gateway can live
     behind Tailscale on a plain http:// tailnet address; the app itself refuses
     cleartext outside tailnet/loopback hosts (TailnetCleartext). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
