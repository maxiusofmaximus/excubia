<style>
  /* Acento común de los dos libros. Va en la cabecera de cada página para que no
     haya ficheros extra que copiar. Los selectores html.<tema> ganan a los de mdBook. */
  html.light,
  html.rust {
    --links: #1f3f8f;
    --sidebar-active: #1f3f8f;
  }
  html.navy,
  html.coal,
  html.ayu {
    --links: #f2a93b;
    --sidebar-active: #f2a93b;
  }
  /* mdBook da al .page un margen superior de -50px para la barra de menú. Como esta
     fila es su primer hijo, ese margen la subiría fuera de la pantalla; el margen
     propio de 50px lo compensa y deja la fila en la parte superior. */
  .site-nav {
    margin-top: 50px;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 2rem;
    padding: 0.7rem 1.5rem;
    margin-bottom: -50px;
    font-size: 1.4rem;
    border-bottom: 1px solid rgba(127, 127, 127, 0.35);
  }
  .site-nav a {
    color: var(--links);
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav a:hover {
    text-decoration: underline;
  }
</style>
